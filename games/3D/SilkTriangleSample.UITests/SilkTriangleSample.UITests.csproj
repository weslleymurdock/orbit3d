<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Opt out of Microsoft.Testing.Platform VSTest error on .NET 10 SDK -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Appium.WebDriver" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <PropertyGroup>
    <AppPlatform Condition="'$(AppPlatform)' == '' and $([MSBuild]::IsOSPlatform('windows'))">Windows</AppPlatform>
    <AppTargetFramework Condition="'$(AppPlatform)' == 'Windows'">net10.0-windows10.0.19041.0</AppTargetFramework>
    <AppTargetFramework Condition="'$(AppPlatform)' == 'Android'">net10.0-android</AppTargetFramework>
    <AppTargetFramework Condition="'$(AppPlatform)' == 'iOS'">net10.0-ios</AppTargetFramework>
    <AppTargetFramework Condition="'$(AppPlatform)' == 'MacCatalyst'">net10.0-maccatalyst</AppTargetFramework>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildAppReference)' == 'true' and '$(AppTargetFramework)' != ''">
    <ProjectReference Include="..\SilkTriangleSample\SilkTriangleSample.csproj">
      <SetTargetFramework>TargetFramework=$(AppTargetFramework)</SetTargetFramework>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
